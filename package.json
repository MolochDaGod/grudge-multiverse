{
  "name": "@grudge-studio/multiverse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Grudge Multiverse — RTS Toon grudge6 + Bermuda CDN map + dedicated Railway room (/api/mv)",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/strip-map-glb.mjs",
    "preview": "vite preview",
    "deploy:gate": "node scripts/deploy-gate.mjs",
    "smoke:character": "node scripts/smoke-character.mjs",
    "purge:check": "node scripts/purge-redeploy.mjs",
    "deploy": "node scripts/deploy-gate.mjs && npm run build && npx vercel deploy --prod --yes",
    "deploy:all": "node scripts/purge-redeploy.mjs && npm run deploy && npm run deploy:railway",
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "deploy:railway": "cd server && railway up --detach --service grudge-multiverse-room"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "firebase": "^12.14.0",
    "three": "^0.185.1",
    "three-mesh-bvh": "^0.9.9",
    "three-pathfinding": "^1.3.0"
  },
  "devDependencies": {
    "vite": "^6.0.0"
  }
}
